<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_light"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/surface_dark"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvWarningBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#33EF4444"
        android:textColor="@color/status_poor"
        android:padding="10dp"
        android:text="@string/instruction_text"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_dark"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pulse_rate_label"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPulseRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- BPM"
            android:textColor="@color/primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQualityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SQI: --"
            android:textColor="@color/text_light"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTrend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trend: --"
            android:textColor="#38BDF8"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connecting to telemetry server..."
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnToggleFlash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/toggle_torch"
        android:backgroundTint="@color/primary" />

</LinearLayout>
